#!/bin/bash
# wt - git worktree manager
#
# Worktrees live in ~/.worktrees/{repo}/{gemstone}: each worktree dir gets an
# unused gemstone name (ruby, opal, ...) for readable paths and tmux windows.
# No mapping file: `git worktree list` is the single source of truth, and
# commands accept either the gemstone or the branch name. Worktrees of the
# same repo made by other tools (codex, omp, ...) are listed as [ext].
#
#   wt                      - fzf picker: enter opens in tmux, ctrl-n creates
#   wt new <branch> [base]  - create worktree (new or existing branch)
#   wt ls                   - list worktrees
#   wt rm [-f|-d] [name...] - remove worktrees, incl. [ext] (fzf multi-select
#                             if no args); -f: discard changes + delete branch,
#                             -d: discard changes, keep branch
#   wt clean [--idle]       - remove merged/gone worktrees; --idle: remove
#                             worktrees no open tmux pane is cd'd into
#   wt root                 - open main repo in tmux
#   wt path [name]          - print worktree path (for cd / scripting)

set -euo pipefail

WT_ROOT="${WT_ROOT:-$HOME/.worktrees}"

GEMSTONES=(diamond ruby sapphire emerald amethyst topaz opal pearl jade garnet
    aquamarine citrine tourmaline peridot moonstone tanzanite alexandrite
    spinel kunzite morganite)

die() { echo "wt: $*" >&2; exit 1; }

usage() {
    sed -n 's/^#   //p' "$0"
}

# --- repo context -----------------------------------------------------------

require_repo() {
    git rev-parse --git-dir >/dev/null 2>&1 || die "not in a git repository"
    local common
    common=$(git rev-parse --path-format=absolute --git-common-dir)
    MAIN_REPO=$(dirname "$common")
    REPO_NAME=$(basename "$MAIN_REPO")
    REPO_WT_DIR="$WT_ROOT/$REPO_NAME"
}

# tmux session names can't contain . or :
tmux_safe() { echo "${1//[.:]/_}"; }

default_base() {
    local head
    head=$(git -C "$MAIN_REPO" symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null) \
        && { echo "${head#refs/remotes/}"; return; }
    for b in main master; do
        git -C "$MAIN_REPO" show-ref --verify --quiet "refs/heads/$b" && { echo "$b"; return; }
    done
    git -C "$MAIN_REPO" rev-parse --abbrev-ref HEAD
}

available_gemstone() {
    # $1: branch, used as fallback name when all gemstones are taken
    local g candidates=()
    for g in "${GEMSTONES[@]}"; do
        [ -e "$REPO_WT_DIR/$g" ] || candidates+=("$g")
    done
    if [ ${#candidates[@]} -gt 0 ]; then
        echo "${candidates[RANDOM % ${#candidates[@]}]}"
    else
        echo "${1//\//-}"
    fi
}

# Lines of "path<TAB>branch" for wt-managed worktrees (under WT_ROOT).
list_worktrees() { all_worktrees | awk -F'\t' '$3 == "wt" { print $1 "\t" $2 }'; }

# Lines of "path<TAB>branch<TAB>tag" for ALL linked worktrees of this repo;
# tag is "wt" (ours) or "ext" (created by other tools, e.g. codex).
all_worktrees() {
    git -C "$MAIN_REPO" worktree list --porcelain | awk -v root="$REPO_WT_DIR/" -v main="$MAIN_REPO" '
        function emit(    tag) {
            if (path != "" && path != main) {
                tag = (index(path, root) == 1) ? "wt" : "ext"
                printf "%s\t%s\t%s\n", path, branch, tag
            }
            path = ""; branch = ""
        }
        /^worktree / { path = substr($0, 10) }
        /^branch /   { branch = substr($0, 8); sub("refs/heads/", "", branch) }
        /^detached$/ { branch = "(detached)" }
        /^$/ { emit() }
        END  { emit() }
    '
}

worktree_path_for() {
    # Accept a worktree dir name or a branch name (managed or [ext]).
    local q="$1" path branch tag
    while IFS=$'\t' read -r path branch tag; do
        if [ "$(basename "$path")" = "$q" ] || [ "$branch" = "$q" ]; then
            echo "$path"
            return 0
        fi
    done < <(all_worktrees)
    return 1
}

# --- tmux -------------------------------------------------------------------

# 3-pane layout: full-height pane on the left, two stacked on the right.
layout_panes() {
    local win="$1" path="$2"
    tmux split-window -t "$win" -h -c "$path"
    tmux split-window -t "$win" -v -c "$path"
    tmux select-pane -t "$win.0"
}

open_in_tmux() {
    local name="$1" path="$2" session win
    # Non-interactive contexts (omp, scripts): just print the path.
    if [ -n "${WT_NO_TMUX:-}" ] || ! command -v tmux >/dev/null 2>&1; then
        echo "$path"
        return
    fi
    session=$(tmux_safe "$REPO_NAME")
    if [ -n "${TMUX:-}" ]; then
        if tmux list-windows -F '#{window_name}' | grep -Fqx "$name"; then
            tmux select-window -t "$name"
        else
            win=$(tmux new-window -P -F '#{window_id}' -n "$name" -c "$path")
            layout_panes "$win" "$path"
        fi
    else
        if ! tmux has-session -t "=$session" 2>/dev/null; then
            win=$(tmux new-session -d -P -F '#{window_id}' -s "$session" -n "$name" -c "$path")
            layout_panes "$win" "$path"
        elif ! tmux list-windows -t "=$session" -F '#{window_name}' | grep -Fqx "$name"; then
            win=$(tmux new-window -t "=$session" -P -F '#{window_id}' -n "$name" -c "$path")
            layout_panes "$win" "$path"
        fi
        tmux select-window -t "=$session:$name"
        tmux attach-session -t "=$session"
    fi
}

# --- picker -----------------------------------------------------------------

picker_lines() {
    # $1: scope ("wt" = managed only, "all" = include [ext] worktrees).
    # Emits "path<TAB>display-name<TAB>branch[tag]" lines for fzf (--ansi):
    # gemstone names are colored, [ext] entries are dimmed.
    local scope="$1" list
    list=$(all_worktrees)
    [ "$scope" = "wt" ] && list=$(echo "$list" | awk -F'\t' '$3 == "wt"')
    [ -n "$list" ] || return 0
    echo "$list" | awk -F'\t' '
    BEGIN {
        # xterm-256 approximations of the gemstone colors
        # (24-bit codes are dropped by fzf in non-truecolor terminals)
        c["diamond"]     = 195   # light icy blue
        c["ruby"]        = 161   # deep red-pink
        c["sapphire"]    = 25    # deep blue
        c["emerald"]     = 78    # green
        c["amethyst"]    = 140   # purple
        c["topaz"]       = 222   # golden orange
        c["opal"]        = 151   # opalescent teal
        c["pearl"]       = 230   # pearl white
        c["jade"]        = 36    # jade green
        c["garnet"]      = 88    # dark red
        c["aquamarine"]  = 122   # aqua
        c["citrine"]     = 184   # yellow
        c["tourmaline"]  = 205   # pink
        c["peridot"]     = 190   # lime
        c["moonstone"]   = 250   # silver
        c["tanzanite"]   = 63    # blue-violet
        c["alexandrite"] = 97    # purple-red
        c["spinel"]      = 198   # bright pink
        c["kunzite"]     = 217   # light pink
        c["morganite"]   = 218   # peach pink
    }
    {
        base = substr($1, match($1, /[^\/]+$/))
        disp = base
        if ($3 == "ext")
            disp = base "  \033[2m[ext]\033[0m"
        else if (base in c)
            disp = "\033[38;5;" c[base] "m" base "\033[0m"
        printf "%s\t%s\t%s\n", $1, disp, $2
    }'
}

pick() {
    # $1: scope; remaining args: fzf flags. stdout: "path<TAB>branch" lines.
    local scope="$1" lines
    shift
    lines=$(picker_lines "$scope")
    [ -n "$lines" ] || die "no worktrees for $REPO_NAME (create one: wt new <branch>)"
    echo "$lines" \
        | fzf "$@" --ansi --delimiter='\t' --with-nth=2,3 \
              --preview 'git -C {1} log --oneline --color=always -10' \
              --preview-window=down,30% \
        | cut -f1,3
}

# --- commands ---------------------------------------------------------------

cmd_new() {
    [ $# -ge 1 ] || die "usage: wt new <branch> [base]"
    local branch="$1" base="${2:-}" name path
    name=$(available_gemstone "$branch")
    path="$REPO_WT_DIR/$name"

    # Branch already checked out somewhere under WT_ROOT? Just go there.
    local existing
    if existing=$(worktree_path_for "$branch"); then
        echo "worktree for '$branch' already exists: $existing"
        open_in_tmux "$(basename "$existing")" "$existing"
        return
    fi
    [ -e "$path" ] && die "$path already exists but is not a worktree of this repo"

    mkdir -p "$REPO_WT_DIR"
    if git -C "$MAIN_REPO" show-ref --verify --quiet "refs/heads/$branch"; then
        echo "creating worktree '$name' for existing branch '$branch'"
        git -C "$MAIN_REPO" worktree add "$path" "$branch"
    elif git -C "$MAIN_REPO" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
        echo "creating worktree '$name' tracking origin/$branch"
        git -C "$MAIN_REPO" worktree add --track -b "$branch" "$path" "origin/$branch"
    else
        base="${base:-$(default_base)}"
        echo "creating worktree '$name' with branch '$branch' from '$base'"
        git -C "$MAIN_REPO" worktree add -b "$branch" "$path" "$base"
        if command -v gt >/dev/null 2>&1; then
            # </dev/null: never let gt go interactive (e.g. graphite init prompt)
            if (cd "$path" && gt branch track >/dev/null 2>&1 </dev/null); then
                echo "tracked in graphite"
            fi
        fi
    fi

    # Optional per-repo init hook (deps install etc.)
    local hook="$REPO_WT_DIR/init.sh"
    if [ -x "$hook" ]; then
        echo "running $hook"
        (cd "$path" && "$hook")
    fi

    open_in_tmux "$name" "$path"
}

cmd_ls() {
    local path branch tag dirty first_ext=1
    while IFS=$'\t' read -r path branch tag; do
        [ "$tag" = "ext" ] && continue
        dirty=""
        [ -n "$(git -C "$path" status --porcelain 2>/dev/null | head -1)" ] && dirty=" *"
        printf '%-14s %s%s\n' "$(basename "$path")" "$branch" "$dirty"
    done < <(all_worktrees)
    while IFS=$'\t' read -r path branch tag; do
        [ "$tag" = "ext" ] || continue
        [ $first_ext = 1 ] && { echo "external:"; first_ext=0; }
        printf '  %-14s %-28s %s\n' "$(basename "$path")" "$branch" "$path"
    done < <(all_worktrees)
}

remove_one() {
    # $3 mode: safe    - refuse dirty tree; delete branch only if fully merged
    #          force   - discard changes, force-delete branch
    #          discard - discard changes, always keep the branch
    local path="$1" branch="$2" mode="$3" name
    name=$(basename "$path")

    # Kill matching tmux window instead of refusing.
    local session
    session=$(tmux_safe "$REPO_NAME")
    tmux kill-window -t "=$session:$name" 2>/dev/null || true

    if [ -f "$path/.gitmodules" ]; then
        (cd "$path" && git submodule deinit --all -f >/dev/null 2>&1) || true
    fi

    if [ "$mode" = safe ]; then
        git -C "$MAIN_REPO" worktree remove "$path" 2>/dev/null \
            || die "'$name' has uncommitted changes; discard them with: wt rm -d $name"
    else
        git -C "$MAIN_REPO" worktree remove --force "$path"
    fi
    echo "removed worktree $name"

    [ "$branch" = "(detached)" ] && return 0
    case "$mode" in
        discard)
            echo "kept branch '$branch'" ;;
        force)
            git -C "$MAIN_REPO" branch -D "$branch" && echo "deleted branch $branch" ;;
        safe)
            if git -C "$MAIN_REPO" branch -d "$branch" 2>/dev/null; then
                echo "deleted branch $branch"
            else
                echo "kept branch '$branch' (not fully merged; delete: git branch -D $branch)"
            fi ;;
    esac
}

cmd_rm() {
    local mode=safe
    while :; do
        case "${1:-}" in
            -f|--force)   mode=force;   shift ;;
            -d|--discard) mode=discard; shift ;;
            *) break ;;
        esac
    done

    local candidates=() path branch
    if [ $# -eq 0 ]; then
        local selected
        selected=$(pick all -m --header='select worktrees to remove (tab to multi-select)') || exit 0
        [ -n "$selected" ] || exit 0
        while IFS=$'\t' read -r path branch; do
            candidates+=("$path"$'\t'"$branch")
        done <<< "$selected"
    else
        local q
        for q in "$@"; do
            path=$(worktree_path_for "$q") || die "no worktree matching '$q'"
            branch=$(all_worktrees | awk -F'\t' -v p="$path" '$1 == p { print $2 }')
            candidates+=("$path"$'\t'"$branch")
        done
    fi

    printf '  %s\n' "${candidates[@]//$'\t'/  }"
    local answer
    printf 'remove these %d worktree(s)? [y/N] ' ${#candidates[@]}
    read -r answer
    [ "$answer" = "y" ] || [ "$answer" = "Y" ] || { echo "aborted"; return; }

    local entry
    for entry in "${candidates[@]}"; do
        remove_one "${entry%%$'\t'*}" "${entry#*$'\t'}" "$mode"
    done
}

cmd_clean() {
    git -C "$MAIN_REPO" worktree prune

    # wt clean         -> worktrees merged into the default branch (or upstream gone)
    # wt clean --idle  -> worktrees no open tmux pane is cd'd into
    local idle=0
    case "${1:-}" in --idle|idle) idle=1 ;; esac

    local pane_cwds=""
    if [ $idle = 1 ]; then
        pane_cwds=$(tmux list-panes -a -F '#{pane_current_path}' 2>/dev/null || true)
    fi

    in_use() {
        # Is any open tmux pane cd'd into $1 (or a subdir of it)?
        local p
        [ -n "$pane_cwds" ] || return 1
        while IFS= read -r p; do
            case "$p" in "$1"|"$1"/*) return 0 ;; esac
        done <<<"$pane_cwds"
        return 1
    }

    local base candidates=() path branch what force
    base=$(default_base)

    while IFS=$'\t' read -r path branch; do
        # Never auto-clean a dirty tree.
        [ -n "$(git -C "$path" status --porcelain 2>/dev/null | head -1)" ] && continue
        if [ $idle = 1 ]; then
            in_use "$path" && continue
        elif [ "$branch" != "(detached)" ]; then
            # keep unless merged into base or upstream deleted
            [ "$(git -C "$MAIN_REPO" for-each-ref --format='%(upstream:track)' "refs/heads/$branch")" = "[gone]" ] \
                || git -C "$MAIN_REPO" merge-base --is-ancestor "$branch" "$base" 2>/dev/null \
                || continue
        fi
        # detached worktrees with a clean tree are always cleanable
        candidates+=("$path"$'\t'"$branch")
    done < <(list_worktrees)

    if [ ${#candidates[@]} -eq 0 ]; then
        echo "nothing to clean"
        return
    fi

    if [ $idle = 1 ]; then
        what="not open in any tmux pane, clean working tree"
        force=safe   # keep unmerged branches; only the worktree dir goes
    else
        what="merged into $base, upstream gone, or detached; clean working tree"
        force=force
    fi
    echo "$what:"
    printf '  %s\n' "${candidates[@]//$'\t'/  }"
    printf 'remove these %d worktree(s)? [y/N] ' ${#candidates[@]}
    read -r answer
    [ "$answer" = "y" ] || [ "$answer" = "Y" ] || { echo "aborted"; return; }

    local entry
    for entry in "${candidates[@]}"; do
        remove_one "${entry%%$'\t'*}" "${entry#*$'\t'}" "$force"
    done
}

cmd_path() {
    if [ $# -eq 0 ]; then
        local selected
        selected=$(pick all --header='select worktree') || exit 1
        [ -n "$selected" ] || exit 1
        echo "${selected%%$'\t'*}"
    else
        worktree_path_for "$1" || die "no worktree matching '$1'"
    fi
}

cmd_switch() {
    # Main picker. Works with an empty list: ctrl-n creates a worktree from
    # the typed query (or prompts for a branch name).
    local out query key selection path branch
    out=$(picker_lines all \
        | fzf --ansi --delimiter='\t' --with-nth=2,3 \
              --print-query --expect=ctrl-n \
              --header="$REPO_NAME worktrees | enter: open | ctrl-n: new worktree (typed text = branch)" \
              --preview 'git -C {1} log --oneline --color=always -10' \
              --preview-window=down,30%) || true
    query=$(sed -n 1p <<<"$out")
    key=$(sed -n 2p <<<"$out")
    selection=$(sed -n 3p <<<"$out")

    if [ "$key" = "ctrl-n" ]; then
        branch="$query"
        if [ -z "$branch" ]; then
            printf 'new branch name: '
            read -r branch </dev/tty || exit 0
        fi
        [ -n "$branch" ] || exit 0
        cmd_new "$branch"
    elif [ -n "$selection" ]; then
        path="${selection%%$'\t'*}"
        open_in_tmux "$(basename "$path")" "$path"
    fi
}

# --- main -------------------------------------------------------------------

case "${1:-}" in
    -h|--help|help) usage; exit 0 ;;
esac

require_repo

case "${1:-}" in
    "")      cmd_switch ;;
    new|create) shift; cmd_new "$@" ;;
    ls|list) cmd_ls ;;
    rm|delete|remove) shift; cmd_rm "$@" ;;
    clean)   shift; cmd_clean "$@" ;;
    root)    open_in_tmux "root" "$MAIN_REPO" ;;
    path|cd) shift; cmd_path "$@" ;;
    *)       usage >&2; die "unknown command '$1'" ;;
esac
